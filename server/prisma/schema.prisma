generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionLanguage {
  JAVA
  PYTHON
  CPP
  NODEJS
}

enum SubmissionStatus {
  QUEUED
  ASSIGNED
  STARTING
  COMPILING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  SYSTEM_ERROR
  CANCELLED
}

enum TestResultStatus {
  PASSED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
}

enum WorkerStatus {
  ONLINE
  OFFLINE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
}

model Problem {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  description  String
  difficulty   Difficulty
  constraints  String
  inputFormat  String
  outputFormat String
  examples     Json
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  testCases    TestCase[]
  submissions  Submission[]

  @@index([isPublished, difficulty])
}

model TestCase {
  id               String                @id @default(uuid())
  problemId        String
  input            String
  expectedOut      String
  isHidden         Boolean               @default(true)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  problem          Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  versions         TestCaseVersion[]
  executionResults ExecutionTestResult[]

  @@index([problemId])
}

model TestCaseVersion {
  testCaseId  String
  version     Int
  input       String
  expectedOut String
  isHidden    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  testCase    TestCase            @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executions  ExecutionTestCase[]

  @@id([testCaseId, version])
  @@index([testCaseId, createdAt])
}

model Submission {
  id                 String             @id @default(uuid())
  userId             String
  problemId          String
  language           SubmissionLanguage
  sourceCode         String             @db.Text
  status             SubmissionStatus   @default(QUEUED)
  priority           Int                @default(0)
  attemptCount       Int                @default(0)
  workerId           String?
  leaseToken         String?
  leaseExpiresAt     DateTime?
  lastEnqueuedAt     DateTime           @default(now())
  needsDispatch      Boolean            @default(false)
  rerunOfExecutionId String?
  executionTimeMs    Int?
  memoryUsedKb       Int?
  errorMessage       String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem            Problem            @relation(fields: [problemId], references: [id], onDelete: Restrict)
  executions         Execution[]
  rerunOfExecution   Execution?         @relation("ExecutionReruns", fields: [rerunOfExecutionId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([problemId, status])
  @@index([status, leaseExpiresAt])
  @@index([status, lastEnqueuedAt])
  @@index([status, needsDispatch, lastEnqueuedAt])
  @@index([rerunOfExecutionId])
}

model Worker {
  id              String            @id
  status          WorkerStatus      @default(ONLINE)
  activeJobs      Int               @default(0)
  capabilities    String[]          @default([])
  lastHeartbeatAt DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  heartbeats      WorkerHeartbeat[]

  @@index([status, lastHeartbeatAt])
}

model WorkerHeartbeat {
  id           String       @id @default(uuid())
  workerId     String
  status       WorkerStatus
  activeJobs   Int
  capabilities String[]     @default([])
  recordedAt   DateTime     @default(now())
  worker       Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt])
}

model Execution {
  id                String                @id @default(uuid())
  submissionId      String
  attemptNumber     Int                   @default(1)
  languageVersion   String
  dockerImage       String
  dockerImageDigest String?
  dockerImageId     String?
  sourceCodeSha256  String?
  profileSnapshot   Json?
  timeLimitMs       Int
  memoryLimitMb     Int
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  executionTimeMs   Int?
  memoryUsedKb      Int?
  submission        Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reruns            Submission[]          @relation("ExecutionReruns")
  testCases         ExecutionTestCase[]
  testResults       ExecutionTestResult[]

  @@unique([submissionId, attemptNumber])
  @@index([submissionId, startedAt])
}

model ExecutionTestCase {
  id              String               @id @default(cuid())
  executionId     String
  testIndex       Int
  testCaseId      String
  testCaseVersion Int
  execution       Execution            @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCase        TestCaseVersion      @relation(fields: [testCaseId, testCaseVersion], references: [testCaseId, version], onDelete: Restrict)
  result          ExecutionTestResult?

  @@unique([executionId, testIndex])
  @@index([testCaseId, testCaseVersion])
}

model ExecutionTestResult {
  id                  String             @id @default(uuid())
  executionId         String
  testCaseId          String?
  testIndex           Int
  executionTestCaseId String?            @unique
  status              TestResultStatus
  executionTimeMs     Int?
  errorMessage        String?            @db.Text
  execution           Execution          @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCase            TestCase?          @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  executionTestCase   ExecutionTestCase? @relation(fields: [executionTestCaseId], references: [id], onDelete: SetNull)

  @@unique([executionId, testIndex])
  @@index([testCaseId])
}
