generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionLanguage {
  JAVA
  PYTHON
  CPP
  NODEJS
}

enum SubmissionStatus {
  QUEUED
  ASSIGNED
  STARTING
  COMPILING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  SYSTEM_ERROR
  CANCELLED
}

enum TestResultStatus {
  PASSED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[]
}

model Problem {
  id           String       @id @default(uuid())
  slug         String       @unique
  title        String
  description  String
  difficulty   Difficulty
  constraints  String
  inputFormat  String
  outputFormat String
  examples     Json
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  testCases    TestCase[]
  submissions  Submission[]

  @@index([isPublished, difficulty])
}

model TestCase {
  id               String                @id @default(uuid())
  problemId        String
  input            String
  expectedOut      String
  isHidden         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  problem          Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  executionResults ExecutionTestResult[]

  @@index([problemId])
}

model Submission {
  id              String             @id @default(uuid())
  userId          String
  problemId       String
  language        SubmissionLanguage
  sourceCode      String             @db.Text
  status          SubmissionStatus   @default(QUEUED)
  executionTimeMs Int?
  memoryUsedKb    Int?
  errorMessage    String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem            @relation(fields: [problemId], references: [id], onDelete: Restrict)
  executions      Execution[]

  @@index([userId, createdAt])
  @@index([problemId, status])
}

model Execution {
  id              String                @id @default(uuid())
  submissionId    String
  attemptNumber   Int                   @default(1)
  languageVersion String
  dockerImage     String
  timeLimitMs     Int
  memoryLimitMb   Int
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  executionTimeMs Int?
  memoryUsedKb    Int?
  submission      Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testResults     ExecutionTestResult[]

  @@unique([submissionId, attemptNumber])
  @@index([submissionId, startedAt])
}

model ExecutionTestResult {
  id              String           @id @default(uuid())
  executionId     String
  testCaseId      String?
  testIndex       Int
  status          TestResultStatus
  executionTimeMs Int?
  errorMessage    String?          @db.Text
  execution       Execution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  testCase        TestCase?        @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@unique([executionId, testIndex])
  @@index([testCaseId])
}
